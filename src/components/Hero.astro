// Build greeble instanced meshes
function buildInstanced(geo: BufferGeometry, list: Greeble[], material: MeshStandardMaterial | MeshBasicMaterial, withColor: boolean): InstancedMesh {
  const mesh = new InstancedMesh(geo, material, list.length);
  list.forEach((d, i) => {
    tmpMatrix.compose(d.p, d.q, d.s);
    mesh.setMatrixAt(i, tmpMatrix);
    if (withColor) mesh.setColorAt(i, tmpColor.setScalar(d.tone ?? 0));
  });
  mesh.instanceMatrix.needsUpdate = true;
  if (mesh.instanceColor) mesh.instanceColor.needsUpdate = true;
  scene.add(mesh);
  return mesh;
}
const unitBox = new BoxGeometry(1, 1, 1);
const unitCyl = new CylinderGeometry(1, 1, 1, 20, 1);
buildInstanced(unitBox, boxDetails, hardwareMaterial, true);
buildInstanced(unitCyl, cylDetails, darkMetalMaterial, true);
buildInstanced(unitBox, amberDetails, amberEmissive, false);

// ============================================================================
// Specimen tank model (merged + instanced)
// ============================================================================
const _pm = new Matrix4();
const _pe = new Euler();
function part(list: BufferGeometry[], geo: BufferGeometry, x = 0, y = 0, z = 0, rx = 0, ry = 0, rz = 0): void {
  const g = geo.index ? geo.toNonIndexed() : geo;
  if (g !== geo) geo.dispose();
  _pm.makeRotationFromEuler(_pe.set(rx, ry, rz));
  _pm.setPosition(x, y, z);
  g.applyMatrix4(_pm);
  list.push(g);
}
function scaleUV(geo: BufferGeometry, k: number): BufferGeometry {
  const a = geo.attributes.uv;
  for (let i = 0; i < a.count; i++) a.setXY(i, a.getX(i) * k, a.getY(i) * k);
  return geo;
}

function buildTankGeometries() {
  const metal: BufferGeometry[] = [], cyan: BufferGeometry[] = [], amber: BufferGeometry[] = [];
  const oct = Math.PI / 8;
  const top = TANK_CENTER_Y + TANK_HALF_H;
  const bottom = TANK_CENTER_Y - TANK_HALF_H;

  // Base
  part(metal, scaleUV(new CylinderGeometry(1.62, 1.7, 0.3, 8, 1, false, oct), 2), 0, 0.15);
  part(metal, scaleUV(new CylinderGeometry(1.48, 1.55, 0.55, 8, 1, false, oct), 2), 0, 0.57);
  part(metal, scaleUV(new CylinderGeometry(1.34, 1.44, 0.55, 8, 1, false, oct), 2), 0, 1.12);
  part(metal, new TorusGeometry(1.3, 0.05, 6, 32), 0, 0.86, 0, Math.PI / 2);
  // Cradle arms
  for (const sx of [-1, 1]) {
    part(metal, new BoxGeometry(0.42, 1.9, 1.55), sx * 1.32, 1.25, 0);
    part(metal, new BoxGeometry(0.36, 0.7, 1.35), sx * 1.18, 2.3, 0, 0, 0, sx * 0.35);
    part(metal, new BoxGeometry(0.1, 1.5, 1.62), sx * 1.56, 1.2, 0);
    part(metal, new TorusGeometry(0.34, 0.05, 6, 16, Math.PI), sx * 1.58, 0.7, 0.35, 0, sx * Math.PI / 2, 0);
    part(metal, new TorusGeometry(0.24, 0.04, 6, 16, Math.PI), sx * 1.58, 0.75, -0.35, 0, sx * Math.PI / 2, 0);
  }
  // Front mechanical discs
  for (const sx of [-0.52, 0.52]) {
    part(metal, new CylinderGeometry(0.3, 0.3, 0.3, 24), sx, 0.5, 1.42, Math.PI / 2);
    part(metal, new CylinderGeometry(0.17, 0.17, 0.42, 16), sx, 0.5, 1.46, Math.PI / 2);
    part(metal, new TorusGeometry(0.3, 0.035, 6, 24), sx, 0.5, 1.58);
  }
  part(metal, new BoxGeometry(0.5, 0.35, 0.3), 0, 0.5, 1.45);
  // Glass collars
  part(metal, new CylinderGeometry(1.26, 1.3, 0.26, 32), 0, bottom - 0.1);
  part(metal, new TorusGeometry(1.2, 0.055, 8, 48), 0, bottom + 0.02, 0, Math.PI / 2);
  part(metal, new CylinderGeometry(1.3, 1.26, 0.3, 32), 0, top + 0.12);
  part(metal, new TorusGeometry(1.2, 0.055, 8, 48), 0, top - 0.02, 0, Math.PI / 2);
  // Top cap
  part(metal, scaleUV(new CylinderGeometry(1.42, 1.52, 0.55, 8, 1, false, oct), 2), 0, top + 0.54);
  part(metal, scaleUV(new CylinderGeometry(1.2, 1.4, 0.35, 8, 1, false, oct), 2), 0, top + 0.98);
  part(metal, new BoxGeometry(2.2, 0.28, 0.6), 0, top + 0.65, -0.9);
  // Pipes to ceiling
  part(metal, new CylinderGeometry(0.22, 0.22, 1.8, 16), 0, top + 1.9, -0.4);
  part(metal, new CylinderGeometry(0.13, 0.13, 1.8, 12), -0.6, top + 1.9, 0.1);
  part(metal, new CylinderGeometry(0.13, 0.13, 1.8, 12), 0.6, top + 1.9, 0.1);
  part(metal, new CylinderGeometry(0.3, 0.3, 0.14, 16), 0, top + 1.4, -0.4);
  // Vertical struts around glass
  const strutH = top - bottom + 0.2;
  for (const a of [Math.PI * 0.75, -Math.PI * 0.75]) {
    part(metal, new BoxGeometry(0.13, strutH, 0.2), Math.sin(a) * 1.2, TANK_CENTER_Y, Math.cos(a) * 1.2, 0, a, 0);
  }
  for (const a of [Math.PI / 2, -Math.PI / 2]) {
    part(metal, new BoxGeometry(0.2, strutH, 0.34), Math.sin(a) * 1.22, TANK_CENTER_Y, Math.cos(a) * 1.22, 0, a, 0);
  }
  // Back spine with cable bundle
  part(metal, new BoxGeometry(0.7, strutH + 0.6, 0.35), 0, TANK_CENTER_Y, -1.3);
  for (const sx of [-0.2, 0, 0.2]) part(metal, new CylinderGeometry(0.06, 0.06, strutH, 8), sx, TANK_CENTER_Y, -1.52);

  // Cyan emissive: top light plate, rings, cap bars
  part(cyan, new CylinderGeometry(0.72, 0.72, 0.04, 32), 0, top - 0.06);
  part(cyan, new TorusGeometry(1.305, 0.018, 6, 64), 0, top + 0.28, 0, Math.PI / 2);
  part(metal, new TorusGeometry(1.31, 0.03, 6, 48), 0, bottom - 0.26, 0, Math.PI / 2);
  part(cyan, new BoxGeometry(0.9, 0.045, 0.02), 0, top + 0.62, 1.4);
  part(cyan, new BoxGeometry(0.6, 0.045, 0.02), 0, top + 0.72, 1.39);
  // Amber indicators
  part(amber, new BoxGeometry(0.28, 0.05, 0.02), -0.95, 0.66, 1.39);
  part(amber, new BoxGeometry(0.28, 0.05, 0.02), 0.95, 0.66, 1.39);
  part(amber, new BoxGeometry(0.06, 0.06, 0.02), 0, 1.2, 1.29);

  const m = mergeGeometries(metal)!;
  const c = mergeGeometries(cyan)!;
  const a = mergeGeometries(amber)!;
  metal.forEach((g) => g.dispose()); cyan.forEach((g) => g.dispose()); amber.forEach((g) => g.dispose());
  return { metal: m, cyan: c, amber: a };
}

const tankGeo = buildTankGeometries();
const tankMetal = new InstancedMesh(tankGeo.metal, hardwareMaterial, TANK_COUNT);
const tankCyan = new InstancedMesh(tankGeo.cyan, cyanEmissive, TANK_COUNT);
const tankAmber = new InstancedMesh(tankGeo.amber, amberEmissive, TANK_COUNT);
// Each tank faces the default viewpoint so frame struts sit on the silhouette
TANKS.forEach((t) => { t.yaw = Math.atan2(-t.x, 4.6 - t.z); });
TANKS.forEach((t, i) => {
  tmpPos.set(t.x, 0, t.z);
  tmpQuat.setFromEuler(tmpEuler.set(0, t.yaw, 0));
  tmpScale.set(1, 1, 1);
  tmpMatrix.compose(tmpPos, tmpQuat, tmpScale);
  tankMetal.setMatrixAt(i, tmpMatrix);
  tankCyan.setMatrixAt(i, tmpMatrix);
  tankAmber.setMatrixAt(i, tmpMatrix);
  tankCyan.setColorAt(i, tmpColor.set(1, 1, 1));
});
scene.add(tankMetal, tankCyan, tankAmber);

// ============================================================================
// Raymarched liquid volume with specimen
// ============================================================================
const liquidVertex = /* glsl */`
  varying vec3 vWorld;
  void main() {
    vec4 wp = modelMatrix * vec4(position, 1.0);
    vWorld = wp.xyz;
    gl_Position = projectionMatrix * viewMatrix * wp;
  }
`;

const liquidFragment = /* glsl */`
  uniform float uTime;
  uniform vec3 uCenter;
  uniform float uRadius;
  uniform float uHalfH;
  uniform float uFlicker;
  uniform float uDensity;
  uniform float uSpecimenGlow;
  uniform float uSeed;
  uniform vec3 uLiquid;
  uniform vec3 uGlow;
  uniform vec3 uFogColor;
  uniform float uFogDensity;
  uniform vec4 uSpine[6];
  uniform vec4 uLimbA[4];
  uniform vec4 uLimbB[4];
  varying vec3 vWorld;

  ${GLSL_NOISE}

  float sdCone(vec3 p, vec3 a, vec3 b, float ra, float rb) {
    vec3 pa = p - a, ba = b - a;
    float h = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-6), 0.0, 1.0);
    return length(pa - ba * h) - mix(ra, rb, h);
  }
  float smin(float a, float b, float k) {
    float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
    return mix(b, a, h) - k * h * (1.0 - h);
  }
  float specimen(vec3 p) {
    float d = 1e5;
    for (int i = 0; i < 5; i++) {
      d = smin(d, sdCone(p, uSpine[i].xyz, uSpine[i + 1].xyz, uSpine[i].w, uSpine[i + 1].w), 0.2);
    }
    for (int i = 0; i < 4; i++) {
      d = smin(d, sdCone(p, uLimbA[i].xyz, uLimbB[i].xyz, uLimbA[i].w, uLimbB[i].w), 0.12);
    }
    return d;
  }

  void main() {
    vec3 ro = cameraPosition - uCenter;
    vec3 toFrag = vWorld - cameraPosition;
    float tFar = length(toFrag);
    vec3 rd = toFrag / tFar;

    // Ray entry into the cylinder volume
    float a = dot(rd.xz, rd.xz);
    float b = dot(ro.xz, rd.xz);
    float c = dot(ro.xz, ro.xz) - uRadius * uRadius;
    float disc = b * b - a * c;
    float tNear = 0.0;
    if (disc > 0.0 && a > 1e-5) tNear = (-b - sqrt(disc)) / a;
    if (abs(rd.y) > 1e-4) {
      float t1 = (-uHalfH - ro.y) / rd.y;
      float t2 = ( uHalfH - ro.y) / rd.y;
      tNear = max(tNear, min(t1, t2));
    }
    tNear = max(tNear, 0.0);
    if (tFar <= tNear + 1e-3) discard;

    float dt = (tFar - tNear) / float(STEPS);
    float jitter = fract(52.9829189 * fract(dot(gl_FragCoord.xy, vec2(0.06711056, 0.00583715))));
    float t = tNear + dt * jitter;

    vec3 col = vec3(0.0);
    float T = 1.0;
    float light = uFlicker;
    float selfGlow = mix(0.35, 1.0, uFlicker);

    for (int i = 0; i < STEPS; i++) {
      vec3 p = ro + rd * t;
      float h = clamp((p.y + uHalfH) / (2.0 * uHalfH), 0.0, 1.0);
      float r = length(p.xz) / uRadius;

      // Suspended fluid: light falls off from the top plate, soft vertical shafts
      float shaft = vnoise(vec3(p.x * 3.2 + uSeed, p.y * 0.4 - uTime * 0.07, p.z * 3.2));
      float topGlow = 0.14 + 0.85 * h * h * h + 0.25 * smoothstep(0.95, 1.0, h);
      vec3 fluidEm = uLiquid * topGlow * (0.4 + 1.1 * shaft * shaft) * light * (1.0 - 0.45 * r);
      float sigma = 0.2 * uDensity;

      // Specimen
      float d = specimen(p);
      d += (vnoise(p * 5.5 + vec3(uSeed, uTime * 0.12, 0.0)) - 0.5) * 0.09;
      vec3 bodyEm = vec3(0.0);
      if (d < 0.25) {
        // Fine tissue detail: ridged noise gives bright filament networks
        vec3 q = p * 7.0 + vec3(0.0, uTime * 0.04, uSeed);
        float n1 = vnoise(q);
        float n2 = vnoise(q * 2.3 + vec3(4.1, 1.7, 2.9));
        float fil = pow(clamp(1.0 - abs(2.0 * n1 - 1.0), 0.0, 1.0), 7.0);
        float fil2 = pow(clamp(1.0 - abs(2.0 * n2 - 1.0), 0.0, 1.0), 9.0);
        float detail = fil * 0.9 + fil2 * 0.7;
        float dd = d + (n2 - 0.5) * 0.05;
        float body = smoothstep(0.02, -0.06, dd);
        float rim = exp(-abs(dd) * 24.0);
        bodyEm = uGlow * uSpecimenGlow * selfGlow * (0.6 + 0.7 * h) *
                 (rim * 3.4 * (0.3 + 1.6 * detail) + body * (0.06 + 9.0 * detail));
        sigma += body * 7.0 * uDensity;
      }

      vec3 em = fluidEm + bodyEm;
      float att = exp(-sigma * dt);
      col += T * em * dt;
      T *= att;
      t += dt;
      if (T < 0.02) break;
    }

    float alpha = 1.0 - T;
    float fogF = 1.0 - exp(-uFogDensity * uFogDensity * tNear * tNear);
    col = mix(col, uFogColor * alpha, fogF);
    gl_FragColor = vec4(max(col, 0.0), clamp(alpha, 0.0, 1.0));
  }
`;

const liquidGeo = new CylinderGeometry(TANK_RADIUS, TANK_RADIUS, TANK_HALF_H * 2, 48, 1, false);
const specimenState: SpecimenState[] = [];
const liquidMaterials: ShaderMaterial[] = [];
const tankGroup = new Group();
scene.add(tankGroup);

TANKS.forEach((t) => {
  const def = CREATURES[t.creature];
  const spine = def.spine.map(() => new Vector4());
  const limbA = def.limbs.map(() => new Vector4());
  const limbB = def.limbs.map(() => new Vector4());
  const center = new Vector3(t.x, TANK_CENTER_Y, t.z);
  const mat = new ShaderMaterial({
    vertexShader: liquidVertex,
    fragmentShader: liquidFragment,
    defines: { STEPS: PARAMS.performance.raySteps },
    uniforms: {
      uTime: shared.uTime,
      uFogColor: shared.uFogColor,
      uFogDensity: shared.uFogDensity,
      uLiquid: shared.uLiquid,
      uGlow: shared.uGlow,
      uCenter: { value: center },
      uRadius: { value: TANK_RADIUS - 0.01 },
      uHalfH: { value: TANK_HALF_H },
      uFlicker: { value: 1 },
      uDensity: { value: PARAMS.material.liquidDensity },
      uSpecimenGlow: { value: PARAMS.material.specimenGlow },
      uSeed: { value: t.seed * 10.0 },
      uSpine: { value: spine },
      uLimbA: { value: limbA },
      uLimbB: { value: limbB }
    },
    side: BackSide,
    transparent: true,
    depthWrite: false,
    blending: CustomBlending,
    blendSrc: OneFactor,
    blendDst: OneMinusSrcAlphaFactor
  });
  const mesh = new Mesh(liquidGeo, mat);
  mesh.position.copy(center);
  mesh.renderOrder = 3;
  tankGroup.add(mesh);
  liquidMaterials.push(mat);
  specimenState.push({ def, spine, limbA, limbB, seed: t.seed });
});

function updateSpecimens(time: number): void {
  const amp = PARAMS.animation.specimenMotion;
  for (const s of specimenState) {
    const bob = Math.sin(time * 0.23 + s.seed * 3.1) * 0.07 * amp;
    const drift = Math.sin(time * 0.11 + s.seed) * 0.05 * amp;
    const n = s.def.spine.length;
    for (let i = 0; i < n; i++) {
      const b = s.def.spine[i];
      const k = (i / (n - 1)) * 0.8 + 0.2;
      s.spine[i].set(
        b[0] + Math.sin(time * 0.33 + s.seed + i * 0.65) * 0.09 * k * amp + drift,
        b[1] + bob,
        b[2] + Math.cos(time * 0.29 + s.seed * 1.7 + i * 0.5) * 0.07 * k * amp,
        b[3] * (1.0 + Math.sin(time * 0.8 + s.seed + i) * 0.03 * amp)
      );
    }
    for (let j = 0; j < s.def.limbs.length; j++) {
      const la = s.def.limbs[j][0], lb = s.def.limbs[j][1];
      s.limbA[j].set(la[0] + drift, la[1] + bob, la[2], la[3]);
      s.limbB[j].set(
        lb[0] + drift + Math.sin(time * 0.52 + s.seed + j * 1.9) * 0.16 * amp,
        lb[1] + bob + Math.sin(time * 0.4 + j) * 0.05 * amp,
        lb[2] + Math.cos(time * 0.47 + s.seed * 2.0 + j * 1.3) * 0.14 * amp,
        lb[3]
      );
    }
  }
}

// ============================================================================
// Glass shells (fresnel + fake light streak reflections)
// ============================================================================
const glassMaterial = new ShaderMaterial({
  uniforms: {
    uTime: shared.uTime,
    uReflect: { value: PARAMS.material.glassReflection },
    uTint: { value: new Color(PARAMS.colors.tankLight) },
    uFogColor: shared.uFogColor,
    uFogDensity: shared.uFogDensity,
    uLight: shared.uAvgLight
  },
  vertexShader: /* glsl */`
    varying vec3 vN;
    varying vec3 vWorld;
    varying vec3 vLocal;
    void main() {
      vLocal = position;
      vec4 wp = modelMatrix * vec4(position, 1.0);
      vWorld = wp.xyz;
      vN = normalize(mat3(modelMatrix) * normal);
      gl_Position = projectionMatrix * viewMatrix * wp;
    }
  `,
  fragmentShader: /* glsl */`
    uniform float uTime;
    uniform float uReflect;
    uniform vec3 uTint;
    uniform vec3 uFogColor;
    uniform float uFogDensity;
    uniform float uLight;
    varying vec3 vN;
    varying vec3 vWorld;
    varying vec3 vLocal;
    ${GLSL_NOISE}
    void main() {
      vec3 V = normalize(cameraPosition - vWorld);
      vec3 N = normalize(vN);
      float ndv = abs(dot(N, V));
      float fres = pow(clamp(1.0 - ndv, 0.0, 1.0), 4.0);
      vec3 R = reflect(-V, N);
      // Streaks reflecting the tank's own top light and neighbouring lights
      float streak = pow(max(0.0, 1.0 - abs(R.x * 1.4 + R.z * 0.3 - 0.35) * 5.0), 6.0)
                   + 0.6 * pow(max(0.0, 1.0 - abs(R.x - R.z * 0.2 + 0.55) * 7.0), 8.0);
      float hN = (vLocal.y + 2.3) / 4.6;
      float topFade = 0.35 + 0.65 * smoothstep(0.0, 1.0, hN);
      float smudge = 0.7 + 0.6 * vnoise(vec3(vLocal.x * 3.0, vLocal.y * 0.6, vLocal.z * 3.0));
      vec3 col = uTint * (fres * 0.55 + streak * 0.35 * smudge) * topFade * uReflect;
      col += uTint * 0.018 * uReflect;
      float fogF = 1.0 - exp(-uFogDensity * uFogDensity * dot(vWorld - cameraPosition, vWorld - cameraPosition));
      col *= (1.0 - fogF) * mix(0.6, 1.0, uLight);
      gl_FragColor = vec4(col, 1.0);
    }
  `,
  transparent: true,
  depthWrite: false,
  blending: AdditiveBlending
});
const glassGeo = new CylinderGeometry(TANK_RADIUS + 0.04, TANK_RADIUS + 0.04, TANK_HALF_H * 2 + 0.1, 64, 1, true);
TANKS.forEach((t) => {
  const g = new Mesh(glassGeo, glassMaterial);
  g.position.set(t.x, TANK_CENTER_Y, t.z);
  g.renderOrder = 5;
  tankGroup.add(g);
});

// ============================================================================
// Bubbles (GPU animated points)
// ============================================================================
const bubbleUniforms = {
  uTime: shared.uTime,
  uSpeed: { value: PARAMS.animation.bubbleSpeed },
  uSize: { value: PARAMS.geometry.bubbleSize },
  uPointScale: shared.uPointScale,
  uHalfH: { value: TANK_HALF_H },
  uRadius: { value: TANK_RADIUS - 0.06 },
  uCenters: { value: TANKS.map((t) => new Vector3(t.x, TANK_CENTER_Y, t.z)) },
  uFlicker: { value: new Array<number>(TANK_COUNT).fill(1) },
  uColor: { value: new Color(PARAMS.colors.glow) },
  uFogColor: shared.uFogColor,
  uFogDensity: shared.uFogDensity
};
const bubbleMaterial = new ShaderMaterial({
  uniforms: bubbleUniforms,
  vertexShader: /* glsl */`
    uniform float uTime;
    uniform float uSpeed;
    uniform float uSize;
    uniform float uPointScale;
    uniform float uHalfH;
    uniform float uRadius;
    uniform vec3 uCenters[${TANK_COUNT}];
    uniform float uFlicker[${TANK_COUNT}];
    uniform float uFogDensity;
    attribute vec4 aData;   // x, z, phase, speed
    attribute vec4 aExtra;  // size, seed, tank index, wobble
    varying float vAlpha;
    varying float vPx;
    varying float vBright;
    void main() {
      int idx = int(aExtra.z + 0.5);
      float travel = 2.0 * uHalfH;
      float life = fract(aData.z + uTime * aData.w * uSpeed / travel);
      float y = -uHalfH + life * travel;
      float seed = aExtra.y;
      float wob = aExtra.w * (0.3 + life);
      vec2 xz = aData.xy + vec2(sin(uTime * (1.6 + seed) + seed * 6.28), cos(uTime * (1.3 + seed * 0.7) + seed * 4.1)) * wob;
      float rl = length(xz);
      if (rl > uRadius) xz *= uRadius / rl;
      vec3 world = uCenters[idx] + vec3(xz.x, y, xz.y);
      vec4 mv = viewMatrix * vec4(world, 1.0);
      gl_Position = projectionMatrix * mv;
      float size = aExtra.x * uSize * (0.85 + 0.3 * life);
      float px = size * uPointScale / -mv.z;
      gl_PointSize = max(px, 1.5);
      vPx = px;
      float fogF = 1.0 - exp(-uFogDensity * uFogDensity * mv.z * mv.z);
      vAlpha = smoothstep(0.0, 0.06, life) * smoothstep(1.0, 0.92, life) * (1.0 - fogF) * min(1.0, px / 1.5);
      vBright = uFlicker[idx] * (0.35 + 1.1 * life * life);
    }
  `,
  fragmentShader: /* glsl */`
    uniform vec3 uColor;
    varying float vAlpha;
    varying float vPx;
    varying float vBright;
    void main() {
      vec2 uv = gl_PointCoord * 2.0 - 1.0;
      float r = length(uv);
      if (r > 1.0) discard;
      float ring = smoothstep(0.55, 0.88, r) * smoothstep(1.0, 0.86, r);
      float core = 0.1 * (1.0 - r);
      float spec = smoothstep(0.32, 0.0, length(uv - vec2(-0.32, -0.34)));
      float bubble = ring * 0.9 + core + spec * 1.3;
      float dotShape = smoothstep(1.0, 0.0, r);
      float a = mix(dotShape * 0.8, bubble, smoothstep(3.0, 7.0, vPx));
      gl_FragColor = vec4(uColor * a * vAlpha * vBright * 1.6, 1.0);
    }
  `,
  transparent: true,
  depthWrite: false,
  blending: AdditiveBlending
});

let bubblePoints: Points | null = null;
function buildBubbles(): void {
  if (bubblePoints) {
    tankGroup.remove(bubblePoints);
    bubblePoints.geometry.dispose();
  }
  const perTank = PARAMS.geometry.bubblesPerTank;
  const total = perTank * TANK_COUNT;
  const data = new Float32Array(total * 4);
  const extra = new Float32Array(total * 4);
  const rng = mulberry32(2024);
  let n = 0;
  for (let ti = 0; ti < TANK_COUNT; ti++) {
    // Several vertical streams per tank
    const streams: [number, number][] = [];
    for (let s = 0; s < 5; s++) {
      const ang = rng() * Math.PI * 2, rad = 0.2 + rng() * 0.7;
      streams.push([Math.cos(ang) * rad, Math.sin(ang) * rad]);
    }
    for (let k = 0; k < perTank; k++) {
      const inStream = rng() < 0.55;
      let x, z;
      if (inStream) {
        const s = streams[(rng() * streams.length) | 0];
        x = s[0] + (rng() - 0.5) * 0.08; z = s[1] + (rng() - 0.5) * 0.08;
      } else {
        const ang = rng() * Math.PI * 2, rad = Math.sqrt(rng()) * (TANK_RADIUS - 0.1);
        x = Math.cos(ang) * rad; z = Math.sin(ang) * rad;
      }
      const sizeR = Math.pow(rng(), 3.0);
      const size = 0.012 + sizeR * 0.07;
      const speed = 0.22 + sizeR * 0.6 + rng() * 0.15;
      data.set([x, z, rng(), speed], n * 4);
      extra.set([size, rng(), ti, inStream ? 0.03 + rng() * 0.03 : 0.02 + rng() * 0.06], n * 4);
      n++;
    }
  }
  const g = new BufferGeometry();
  g.setAttribute('position', new BufferAttribute(new Float32Array(total * 3), 3));
  g.setAttribute('aData', new BufferAttribute(data, 4));
  g.setAttribute('aExtra', new BufferAttribute(extra, 4));
  g.boundingSphere = new Sphere(new Vector3(0, 4, -10), 40);
  bubblePoints = new Points(g, bubbleMaterial);
  bubblePoints.frustumCulled = false;
  bubblePoints.renderOrder = 4;
  tankGroup.add(bubblePoints);
}
buildBubbles();

// ============================================================================
// Air dust and low floor mist
// ============================================================================
function buildDust(): void {
  const count = 1800;
  const rng = mulberry32(77);
  const p = new Float32Array(count * 3), s = new Float32Array(count);
  for (let i = 0; i < count; i++) {
    p[i * 3] = (rng() - 0.5) * 13;
    p[i * 3 + 1] = rng() * 8.2;
    p[i * 3 + 2] = CORRIDOR_BACK + rng() * (CORRIDOR_FRONT - 2 - CORRIDOR_BACK);
    s[i] = rng();
  }
  const g = new BufferGeometry();
  g.setAttribute('position', new BufferAttribute(p, 3));
  g.setAttribute('aSeed', new BufferAttribute(s, 1));
  const m = new ShaderMaterial({
    uniforms: { uTime: shared.uTime, uPointScale: shared.uPointScale, uFogDensity: shared.uFogDensity, uLight: shared.uAvgLight, uColor: { value: new Color('#7fcfd6') } },
    vertexShader: /* glsl */`
      uniform float uTime;
      uniform float uPointScale;
      uniform float uFogDensity;
      attribute float aSeed;
      varying float vA;
      void main() {
        vec3 p = position;
        p.x += sin(uTime * 0.13 + aSeed * 40.0) * 0.35;
        p.y = mod(p.y + uTime * (0.03 + aSeed * 0.05), 8.2);
        p.z += cos(uTime * 0.11 + aSeed * 23.0) * 0.35;
        vec4 mv = viewMatrix * vec4(p, 1.0);
        gl_Position = projectionMatrix * mv;
        float px = (0.012 + aSeed * 0.018) * uPointScale / -mv.z;
        gl_PointSize = max(px, 1.0);
        float fogF = 1.0 - exp(-uFogDensity * uFogDensity * mv.z * mv.z);
        vA = (1.0 - fogF) * smoothstep(1.5, 4.0, -mv.z) * min(1.0, px) * (0.4 + 0.6 * sin(uTime * 0.7 + aSeed * 60.0) * 0.5 + 0.3);
      }
    `,
    fragmentShader: /* glsl */`
      uniform vec3 uColor;
      uniform float uLight;
      varying float vA;
      void main() {
        float r = length(gl_PointCoord * 2.0 - 1.0);
        if (r > 1.0) discard;
        gl_FragColor = vec4(uColor * smoothstep(1.0, 0.0, r) * vA * 0.5 * uLight, 1.0);
      }
    `,
    transparent: true, depthWrite: false, blending: AdditiveBlending
  });
  const pts = new Points(g, m);
  pts.frustumCulled = false;
  pts.renderOrder = 2;
  scene.add(pts);
}
buildDust();

const mistMaterial = new ShaderMaterial({
  uniforms: {
    uTime: shared.uTime,
    uOpacity: { value: PARAMS.post.mist },
    uColor: { value: new Color('#5aa7ad') },
    uWarm: { value: new Color(PARAMS.colors.amber) },
    uLight: shared.uAvgLight,
    uFogColor: shared.uFogColor,
    uFogDensity: shared.uFogDensity
  },
  vertexShader: /* glsl */`
    varying vec2 vUv;
    varying vec3 vWorld;
    void main() {
      vUv = uv;
      vec4 wp = modelMatrix * vec4(position, 1.0);
      vWorld = wp.xyz;
      gl_Position = projectionMatrix * viewMatrix * wp;
    }
  `,
  fragmentShader: /* glsl */`
    uniform float uTime;
    uniform float uOpacity;
    uniform vec3 uColor;
    uniform vec3 uWarm;
    uniform float uLight;
    uniform float uFogDensity;
    varying vec2 vUv;
    varying vec3 vWorld;
    ${GLSL_NOISE}
    float fbm(vec3 p) {
      float v = 0.0, a = 0.5;
      for (int i = 0; i < 4; i++) { v += a * vnoise(p); p = p * 2.03 + vec3(1.7, 3.1, 0.4); a *= 0.5; }
      return v;
    }
    void main() {
      vec3 q = vec3(vWorld.x * 0.55 + uTime * 0.05, vWorld.y * 0.9 - uTime * 0.03, vWorld.z * 0.35 + uTime * 0.02);
      float n = fbm(q + fbm(q * 0.7 + uTime * 0.02));
      n = smoothstep(0.35, 0.85, n);
      float edge = smoothstep(0.0, 0.25, vUv.x) * smoothstep(1.0, 0.75, vUv.x);
      float vert = smoothstep(0.0, 0.12, vUv.y) * pow(clamp(1.0 - vUv.y, 0.0, 1.0), 1.6);
      float dist = length(vWorld - cameraPosition);
      float fogF = 1.0 - exp(-uFogDensity * uFogDensity * dist * dist);
      float nearFade = smoothstep(2.0, 6.0, dist);
      float warmth = smoothstep(-16.0, -26.0, vWorld.z) * 0.6;
      vec3 col = mix(uColor, uWarm, warmth) * n * edge * vert * uOpacity * 0.3 * (1.0 - fogF * 0.7) * nearFade * mix(0.5, 1.0, uLight);
      gl_FragColor = vec4(col, 1.0);
    }
  `,
  transparent: true, depthWrite: false, blending: AdditiveBlending, side: DoubleSide
});
function buildMist(): void {
  const spots: [number, number, number][] = [
    [-3.4, -3.0, 4.5], [3.6, -3.4, 4.5], [-3.2, -10.2, 5], [3.2, -10.0, 5],
    [-3.0, -17.2, 5], [3.0, -17.0, 5], [-1.6, -21.8, 4], [1.8, -21.6, 4], [0, -25.2, 8], [0, -14, 6]
  ];
  const g = new PlaneGeometry(1, 1);
  spots.forEach(([x, z, w]) => {
    const m = new Mesh(g, mistMaterial);
    m.scale.set(w, 2.6, 1);
    m.position.set(x, 1.3, z);
    m.renderOrder = 1;
    scene.add(m);
  });
}
buildMist();

// ============================================================================
// Lights
// ============================================================================
const hemi = new HemisphereLight(0x10363a, 0x020505, PARAMS.lighting.ambient);
scene.add(hemi);

const tankLightColor = new Color(PARAMS.colors.tankLight);
const tankLights = TANKS.map((t) => {
  const l = new PointLight(tankLightColor, PARAMS.lighting.tankLight, 12, 1.6);
  l.position.set(t.x * 0.92, TANK_CENTER_Y + 0.8, t.z + (t.x === 0 ? 0.9 : 0));
  scene.add(l);
  return l;
});
const amberLights: PointLight[] = [
  [-6.4, 0.5, 3.8], [6.4, 0.5, 3.8], [-1.9, 0.45, -21.5], [1.9, 0.45, -21.5]
].map(([x, y, z]) => {
  const l = new PointLight(amberColor, PARAMS.lighting.amberLight, 7, 1.8);
  l.position.set(x, y, z);
  scene.add(l);
  return l;
});

// ============================================================================
// Flicker controller
// ============================================================================
class FlickerChannel {
  rng: () => number;
  rateMul: number;
  value = 1;
  eventStart = -1;
  eventEnd = -1;
  mode = 0;
  freq = 20;
  next: number;

  constructor(seed: number, rateMul: number) {
    this.rng = mulberry32((seed * 1000) | 0);
    this.rateMul = rateMul;
    this.next = 1.5 + this.rng() * 6;
  }
  trigger(time: number, duration: number, mode: number): void {
    this.eventStart = time;
    this.eventEnd = time + duration;
    this.mode = mode;
    this.freq = 14 + this.rng() * 22;
  }
  target(time: number): number {
    const depth = PARAMS.lighting.flickerDepth;
    if (!PARAMS.lighting.flicker) return 1;
    if (time >= this.next && time > this.eventEnd) {
      const r = this.rng();
      this.trigger(time, 0.12 + this.rng() * (r < 0.7 ? 0.6 : 1.4), r < 0.7 ? 0 : 1);
      this.next = this.eventEnd + (3 + this.rng() * 11) / (PARAMS.lighting.flickerRate * this.rateMul);
    }
    const hum = 0.985 + 0.015 * Math.sin(time * 9.7 + this.freq);
    if (time < this.eventEnd) {
      const k = (time - this.eventStart) / (this.eventEnd - this.eventStart);
      if (this.mode === 0) {
        // Stutter: hard on/off pattern
        const step = Math.floor((time - this.eventStart) * this.freq);
        const h = Math.sin(step * 12.9898 + this.freq * 78.233) * 43758.5453;
        const on = (h - Math.floor(h)) > 0.45;
        return on ? hum : 1 - depth * (0.75 + 0.25 * (h - Math.floor(h)));
      }
      // Brownout: sag and recover with jitter
      const sag = Math.sin(Math.PI * k);
      const jit = Math.sin(time * 61.0) * Math.sin(time * 37.0) * 0.15;
      return Math.max(0.02, 1 - depth * (0.7 * sag + jit * sag));
    }
    return hum;
  }
  update(time: number, dt: number): number {
    const tgt = this.target(time);
    const k = 1 - Math.exp(-dt * (tgt < this.value ? 60 : 28));
    this.value += (tgt - this.value) * k;
    return this.value;
  }
}
const flickers = TANKS.map((t) => new FlickerChannel(t.seed + 0.37, t.faulty));
const amberFlicker = new FlickerChannel(9.1, 0.4);
let nextSurge = 18 + Math.random() * 20;

function powerSurge(time: number): void {
  flickers.forEach((f, i) => f.trigger(time + i * 0.05, 0.7 + Math.random() * 0.6, 0));
  amberFlicker.trigger(time, 0.6, 0);
}

// ============================================================================
// Post-processing
// ============================================================================
const GradeShader = {
  uniforms: {
    tDiffuse: { value: null },
    uTime: { value: 0 },
    uVignette: { value: PARAMS.post.vignette },
    uChromatic: { value: PARAMS.post.chromatic },
    uGrain: { value: PARAMS.post.grain },
    uResolution: { value: new Vector2(1, 1) }
  },
  vertexShader: /* glsl */`
    varying vec2 vUv;
    void main() { vUv = uv; gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0); }
  `,
  fragmentShader: /* glsl */`
    uniform sampler2D tDiffuse;
    uniform float uTime;
    uniform float uVignette;
    uniform float uChromatic;
    uniform float uGrain;
    uniform vec2 uResolution;
    varying vec2 vUv;
    float hash12(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }
    void main() {
      vec2 c = vUv - 0.5;
      float d2 = dot(c, c);
      vec2 off = c * uChromatic * (1.0 + d2 * 6.0);
      vec3 col;
      col.r = texture2D(tDiffuse, vUv - off).r;
      col.g = texture2D(tDiffuse, vUv).g;
      col.b = texture2D(tDiffuse, vUv + off).b;
      // Teal shadows, keep highlights clean
      float l = dot(col, vec3(0.2126, 0.7152, 0.0722));
      col = mix(col * vec3(0.86, 1.03, 1.06), col, smoothstep(0.0, 0.6, l));
      col += vec3(0.0015, 0.006, 0.007);
      // Vignette
      vec2 vc = c * vec2(1.0, 1.25);
      float vig = smoothstep(0.85, 0.15, length(vc));
      col *= mix(1.0, vig, uVignette);
      // Film grain
      float n = hash12(vUv * uResolution + fract(uTime * 7.13) * 400.0) - 0.5;
      col *= 1.0 + n * uGrain * 2.0;
      col = max(col, 0.0);
      gl_FragColor = vec4(col, 1.0);
    }
  `
};

// Removes NaN / Inf pixels and clamps extreme HDR values before bloom
const SanitizeShader = {
  uniforms: { tDiffuse: { value: null } },
  vertexShader: /* glsl */`
    varying vec2 vUv;
    void main() { vUv = uv; gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0); }
  `,
  fragmentShader: /* glsl */`
    uniform sampler2D tDiffuse;
    varying vec2 vUv;
    void main() {
      vec4 c = texture2D(tDiffuse, vUv);
      if (any(isnan(c)) || any(isinf(c))) c = vec4(0.0, 0.0, 0.0, 1.0);
      gl_FragColor = vec4(clamp(c.rgb, 0.0, 64.0), 1.0);
    }
  `
};

const MAX_SAMPLES = renderer.capabilities.maxSamples || 4;
const composerTarget = new WebGLRenderTarget(1, 1, { type: HalfFloatType, samples: Math.min(PARAMS.performance.msaa, MAX_SAMPLES) });
const composer = new EffectComposer(renderer, composerTarget);
const renderPass = new RenderPass(scene, camera);
const bloomPass = new UnrealBloomPass(new Vector2(window.innerWidth, window.innerHeight), PARAMS.post.bloomStrength, PARAMS.post.bloomRadius, PARAMS.post.bloomThreshold);
const sanitizePass = new ShaderPass(SanitizeShader);
const gradePass = new ShaderPass(GradeShader);
const outputPass = new OutputPass();
composer.addPass(renderPass);
composer.addPass(sanitizePass);
composer.addPass(bloomPass);
composer.addPass(gradePass);
composer.addPass(outputPass);
// SMAA runs on the tone-mapped image and cleans edges MSAA cannot reach (shader edges, bright rims)
const smaaPass = new SMAAPass(window.innerWidth, window.innerHeight);
smaaPass.enabled = PARAMS.performance.smaa;
composer.addPass(smaaPass);

// ============================================================================
// Resize / DPR
// ============================================================================
function applySize(): void {
  const w = window.innerWidth, h = window.innerHeight;
  const dpr = Math.min(PARAMS.performance.dpr, MAX_DPR);
  renderer.setPixelRatio(dpr);
  renderer.setSize(w, h);
  composer.setPixelRatio(dpr);
  composer.setSize(w, h);
  camera.aspect = w / h;
  camera.updateProjectionMatrix();
  const bufferH = h * dpr;
  shared.uPointScale.value = bufferH / (2 * Math.tan(MathUtils.degToRad(camera.fov) / 2));
  gradePass.uniforms.uResolution.value.set(w * dpr, h * dpr);
}
applySize();
window.addEventListener('resize', applySize);

// ============================================================================
// GUI
// ============================================================================
const gui = new GUI({ title: 'Xeno Bio Lab' });

const fCam = gui.addFolder('Camera');
fCam.add(PARAMS.camera, 'fov', 30, 80, 1).name('FOV').onChange(() => { updateCamera(); applySize(); });
fCam.add(PARAMS.camera, 'height', 1.2, 5, 0.05).name('Height').onChange(updateCamera);
fCam.add(PARAMS.camera, 'lookHeight', 1, 6, 0.05).name('Look Height').onChange(updateCamera);
fCam.add(PARAMS.camera, 'autoMove').name('Auto Fly-Through');
fCam.add(PARAMS.camera, 'moveSpeed', 0.1, 3, 0.05).name('Move Speed');
fCam.add(PARAMS.camera, 'turnDuration', 2, 15, 0.5).name('Turn Duration');
fCam.add({ restart: () => { Object.assign(cameraRig, { phase: 0, progress: 0, yaw: 0, z: CAMERA_NEAR_Z, x: 0 }); updateCamera(); } }, 'restart').name('Restart Path');

const fAnim = gui.addFolder('Animation');
fAnim.add(PARAMS.animation, 'timeScale', 0, 3, 0.01).name('Time Scale');
fAnim.add(PARAMS.animation, 'bubbleSpeed', 0, 3, 0.01).name('Bubble Speed').onChange((v: number) => { bubbleUniforms.uSpeed.value = v; });
fAnim.add(PARAMS.animation, 'specimenMotion', 0, 3, 0.01).name('Specimen Motion');

const fGeo = gui.addFolder('Geometry');
fGeo.add(PARAMS.geometry, 'bubblesPerTank', 50, 1500, 10).name('Bubbles Per Tank').onFinishChange(buildBubbles);
fGeo.add(PARAMS.geometry, 'bubbleSize', 0.3, 3, 0.05).name('Bubble Size').onChange((v: number) => { bubbleUniforms.uSize.value = v; });

const fMat = gui.addFolder('Material');
fMat.add(PARAMS.material, 'liquidDensity', 0.1, 3, 0.01).name('Liquid Density').onChange((v: number) => liquidMaterials.forEach((m) => { m.uniforms.uDensity.value = v; }));
fMat.add(PARAMS.material, 'specimenGlow', 0, 3, 0.01).name('Specimen Glow').onChange((v: number) => liquidMaterials.forEach((m) => { m.uniforms.uSpecimenGlow.value = v; }));
fMat.add(PARAMS.material, 'glassReflection', 0, 3, 0.01).name('Glass Reflection').onChange((v: number) => { glassMaterial.uniforms.uReflect.value = v; });
fMat.add(PARAMS.material, 'metalRoughness', 0.1, 1, 0.01).name('Metal Roughness').onChange(applyMetal);
fMat.add(PARAMS.material, 'envIntensity', 0, 2, 0.01).name('Reflections').onChange((v: number) => { scene.environmentIntensity = v; });

const fCol = gui.addFolder('Colors');
fCol.addColor(PARAMS.colors, 'liquid').name('Liquid').onChange((v: string) => shared.uLiquid.value.set(v));
fCol.addColor(PARAMS.colors, 'glow').name('Specimen Glow').onChange((v: string) => { shared.uGlow.value.set(v); bubbleUniforms.uColor.value.set(v); });
fCol.addColor(PARAMS.colors, 'tankLight').name('Tank Light').onChange((v: string) => { tankLightColor.set(v); tankLights.forEach((l) => l.color.copy(tankLightColor)); glassMaterial.uniforms.uTint.value.set(v); });
fCol.addColor(PARAMS.colors, 'amber').name('Amber').onChange((v: string) => { amberColor.set(v); amberLights.forEach((l) => l.color.copy(amberColor)); mistMaterial.uniforms.uWarm.value.set(v); });
fCol.addColor(PARAMS.colors, 'fog').name('Fog').onChange((v: string) => { fogColor.set(v); fog.color.copy(fogColor); background.copy(fogColor); shared.uFogColor.value.copy(fogColor); });
fCol.addColor(PARAMS.colors, 'metal').name('Metal').onChange(applyMetal);

const fLight = gui.addFolder('Lighting');
fLight.add(PARAMS.lighting, 'tankLight', 0, 60, 0.5).name('Tank Light');
fLight.add(PARAMS.lighting, 'amberLight', 0, 20, 0.1).name('Amber Light');
fLight.add(PARAMS.lighting, 'ambient', 0, 3, 0.01).name('Ambient').onChange((v: number) => { hemi.intensity = v; });
fLight.add(PARAMS.lighting, 'exposure', 0.3, 2.5, 0.01).name('Exposure').onChange((v: number) => { renderer.toneMappingExposure = v; });
fLight.add(PARAMS.lighting, 'flicker').name('Flicker');
fLight.add(PARAMS.lighting, 'flickerRate', 0.1, 5, 0.05).name('Flicker Rate');
fLight.add(PARAMS.lighting, 'flickerDepth', 0, 1, 0.01).name('Flicker Depth');
fLight.add({ surge: () => powerSurge(elapsed) }, 'surge').name('Trigger Power Surge');

const fPost = gui.addFolder('Post Processing');
fPost.add(PARAMS.post, 'bloomStrength', 0, 3, 0.01).name('Bloom Strength').onChange((v: number) => { bloomPass.strength = v; });
fPost.add(PARAMS.post, 'bloomRadius', 0, 1.5, 0.01).name('Bloom Radius').onChange((v: number) => { bloomPass.radius = v; });
fPost.add(PARAMS.post, 'bloomThreshold', 0, 3, 0.01).name('Bloom Threshold').onChange((v: number) => { bloomPass.threshold = v; });
fPost.add(PARAMS.post, 'vignette', 0, 1.5, 0.01).name('Vignette').onChange((v: number) => { gradePass.uniforms.uVignette.value = v; });
fPost.add(PARAMS.post, 'chromatic', 0, 0.01, 0.0001).name('Chromatic Aberration').onChange((v: number) => { gradePass.uniforms.uChromatic.value = v; });
fPost.add(PARAMS.post, 'grain', 0, 0.2, 0.001).name('Film Grain').onChange((v: number) => { gradePass.uniforms.uGrain.value = v; });
fPost.add(PARAMS.post, 'fogDensity', 0, 0.08, 0.001).name('Fog Density').onChange((v: number) => { fog.density = v; shared.uFogDensity.value = v; });
fPost.add(PARAMS.post, 'mist', 0, 3, 0.01).name('Floor Mist').onChange((v: number) => { mistMaterial.uniforms.uOpacity.value = v; });

const fPerf = gui.addFolder('Performance');
fPerf.add(PARAMS.performance, 'dpr', 0.5, MAX_DPR, 0.05).name('DPR').onChange(applySize);
fPerf.add(PARAMS.performance, 'raySteps', 16, 96, 4).name('Raymarch Steps').onFinishChange((v: number) => {
  liquidMaterials.forEach((m) => { m.defines.STEPS = v; m.needsUpdate = true; });
});
fPerf.add(PARAMS.performance, 'msaa', [0, 2, 4, 8]).name('MSAA Samples').onChange((v: number) => {
  const samples = Math.min(Number(v), MAX_SAMPLES);
  for (const rt of [composer.renderTarget1, composer.renderTarget2]) { rt.samples = samples; rt.dispose(); }
});
fPerf.add(PARAMS.performance, 'smaa').name('SMAA').onChange((v: boolean) => { smaaPass.enabled = v; });
fPerf.add(PARAMS.performance, 'paused').name('Pause');
gui.close();

function applyMetal(): void {
  metalColor.set(PARAMS.colors.metal);
  const r = PARAMS.material.metalRoughness;
  for (const [m, tone, rough] of metalMaterials) {
    m.color.copy(metalColor).multiplyScalar(tone);
    if (rough !== null) m.roughness = r * rough;
  }
  backWallExtraMaterials.forEach((m) => m.color.copy(metalColor).multiplyScalar(0.5));
}

// ============================================================================
// Animation loop
// ============================================================================
const clock = new Clock();
let elapsed = 0;

document.addEventListener('visibilitychange', () => { clock.getDelta(); });

function updateLights(dt: number): void {
  let sum = 0;
  if (PARAMS.lighting.flicker && elapsed > nextSurge) {
    powerSurge(elapsed);
    nextSurge = elapsed + 25 + Math.random() * 35 / PARAMS.lighting.flickerRate;
  }
  for (let i = 0; i < TANK_COUNT; i++) {
    const v = flickers[i].update(elapsed, dt);
    sum += v;
    tankLights[i].intensity = PARAMS.lighting.tankLight * v;
    liquidMaterials[i].uniforms.uFlicker.value = v;
    bubbleUniforms.uFlicker.value[i] = v;
    tmpColor.copy(tankLightColor).multiplyScalar(2.4 * v);
    tankCyan.setColorAt(i, tmpColor);
  }
  if (tankCyan.instanceColor) tankCyan.instanceColor.needsUpdate = true;
  shared.uAvgLight.value = sum / TANK_COUNT;
  const a = amberFlicker.update(elapsed, dt);
  amberLights.forEach((l) => { l.intensity = PARAMS.lighting.amberLight * a; });
  amberEmissive.color.copy(amberColor).multiplyScalar(2.6 * (0.25 + 0.75 * a));
}

renderer.setAnimationLoop(() => {
  const rawDt = Math.min(clock.getDelta(), 0.1);
  if (PARAMS.performance.paused) { composer.render(); return; }
  const dt = rawDt * PARAMS.animation.timeScale;
  elapsed += dt;
  shared.uTime.value = elapsed;
  gradePass.uniforms.uTime.value = elapsed;
  if (PARAMS.camera.autoMove) advanceCameraRig(dt);
  updateCamera();
  updateSpecimens(elapsed);
  updateLights(Math.max(dt, 1e-4));
  composer.render();
});
</script>
