};

const MAX_DPR = 2;

// Guard against NaN normals in bump mapping on surfaces with degenerate UV derivatives
// (normalize(vec3(0)) returns NaN on some GPUs, which bloom then spreads into black blocks)
ShaderChunk.bumpmap_pars_fragment = ShaderChunk.bumpmap_pars_fragment.replace(
  'return normalize( abs( fDet ) * surf_norm - vGrad );',
  'vec3 bumpN = abs( fDet ) * surf_norm - vGrad; float bumpL = length( bumpN ); return bumpL > 1e-6 ? bumpN / bumpL : surf_norm;'
).replace(
  // Built-in bump strength is constant in screen space, so distant texels alias into
  // shimmering lines. Fade the bump once a pixel covers more than ~1 texel.
  'return vec2( dBx, dBy );',
  'vec2 bumpTs = vec2( textureSize( bumpMap, 0 ) ); float bumpFootprint = max( length( dSTdx * bumpTs ), length( dSTdy * bumpTs ) ); return vec2( dBx, dBy ) / ( 1.0 + max( bumpFootprint - 1.0, 0.0 ) * 0.9 );'
);

// Corridor layout
const CORRIDOR_FRONT = 12;
const CORRIDOR_BACK = -28;
const OCTAGON: [number, number][] = [
  [-6.2, 0.0], [6.2, 0.0], [7.6, 1.4], [7.6, 6.6],
  [6.0, 8.6], [-6.0, 8.6], [-7.6, 6.6], [-7.6, 1.4]
];
const RIB_Z = [4.5, -5.0, -12.0, -19.0, -26.2];
const TANK_RADIUS = 1.1;
const TANK_HALF_H = 2.25;
const TANK_CENTER_Y = 1.66 + TANK_HALF_H;

const TANKS: Tank[] = [
  { x: -4.35, z: -1.5, creature: 'beast', seed: 1.3, faulty: 1.0, yaw: 0 },
  { x: 4.35, z: -1.5, creature: 'serpent', seed: 4.1, faulty: 1.0, yaw: 0 },
  { x: -4.35, z: -8.5, creature: 'jelly', seed: 2.7, faulty: 2.6, yaw: 0 },
  { x: 4.35, z: -8.5, creature: 'jelly', seed: 7.9, faulty: 1.0, yaw: 0 },
  { x: -4.35, z: -15.5, creature: 'serpent', seed: 5.5, faulty: 1.0, yaw: 0 },
  { x: 4.35, z: -15.5, creature: 'beast', seed: 3.3, faulty: 1.8, yaw: 0 },
