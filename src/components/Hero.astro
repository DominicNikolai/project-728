    ]
  },
  jelly: {
    spine: [[0.0, 0.55, 0.0, 0.05], [0.0, 0.8, 0.0, 0.32], [0.0, 1.1, 0.0, 0.52], [0.0, 1.4, 0.0, 0.54], [0.0, 1.65, 0.0, 0.38], [0.0, 1.8, 0.0, 0.08]],
    limbs: [
      [[0.3, 0.8, 0.28, 0.06], [0.5, -1.9, 0.42, 0.012]],
      [[-0.3, 0.8, 0.28, 0.06], [-0.45, -1.7, 0.5, 0.012]],
      [[0.3, 0.8, -0.28, 0.06], [0.42, -1.8, -0.5, 0.012]],
      [[-0.3, 0.8, -0.28, 0.06], [-0.5, -2.0, -0.38, 0.012]]
    ]
  }
};

// ============================================================================
// Renderer, scene, camera
// ============================================================================
const renderer = new WebGLRenderer({ antialias: false, powerPreference: 'high-performance' });
renderer.setPixelRatio(Math.min(PARAMS.performance.dpr, MAX_DPR));
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.toneMapping = ACESFilmicToneMapping;
renderer.toneMappingExposure = PARAMS.lighting.exposure;
renderer.outputColorSpace = SRGBColorSpace;
container.appendChild(renderer.domElement);

const scene = new Scene();
const fogColor = new Color(PARAMS.colors.fog);
const background = fogColor.clone();
scene.background = background;
const fog = new FogExp2(fogColor.clone(), PARAMS.post.fogDensity);
scene.fog = fog;

const camera = new PerspectiveCamera(PARAMS.camera.fov, window.innerWidth / window.innerHeight, 0.1, 120);
const cameraTarget = new Vector3();

// Camera fly-through: forward to the last tank, turn around, back to the start, turn, repeat
const CAMERA_NEAR_Z = 4.6;
const CAMERA_FAR_Z = -16.5;
const cameraRig = { phase: 0, progress: 0, yaw: 0, z: CAMERA_NEAR_Z, x: 0 };
const easeInOut = (t: number): number => 0.5 - 0.5 * Math.cos(Math.PI * Math.min(Math.max(t, 0), 1));

function advanceCameraRig(dt: number): void {
  const travel = CAMERA_NEAR_Z - CAMERA_FAR_Z;
  const r = cameraRig;
  if (r.phase === 0 || r.phase === 2) {
    // Progress rate is in metres per second of the average speed
    r.progress += dt * PARAMS.camera.moveSpeed / travel;
    const k = easeInOut(r.progress);
    r.z = r.phase === 0 ? CAMERA_NEAR_Z - travel * k : CAMERA_FAR_Z + travel * k;
    r.x = 0;
    r.yaw = r.phase === 0 ? 0 : Math.PI;
  } else {
    r.progress += dt / PARAMS.camera.turnDuration;
    const k = easeInOut(r.progress);
    const base = r.phase === 1 ? 0 : Math.PI;
    r.yaw = base + Math.PI * k;
    // Small sideways arc while turning so the move feels like a walk, not a spin
    r.x = Math.sin(Math.PI * k) * 0.35 * (r.phase === 1 ? 1 : -1);
    r.z = r.phase === 1 ? CAMERA_FAR_Z : CAMERA_NEAR_Z;
  }
  if (r.progress >= 1) {
    r.progress = 0;
    r.phase = (r.phase + 1) % 4;
    if (r.phase === 0) r.yaw = 0;
  }
}

function updateCamera(): void {
  if (camera.fov !== PARAMS.camera.fov) {
    camera.fov = PARAMS.camera.fov;
    camera.updateProjectionMatrix();
  }
  const r = cameraRig;
  camera.position.set(r.x, PARAMS.camera.height, r.z);
  // Look far ahead along the current heading; pitch follows Look Height
  const lookDist = 28;
  cameraTarget.set(
    r.x - Math.sin(r.yaw) * lookDist,
    PARAMS.camera.lookHeight,
    r.z - Math.cos(r.yaw) * lookDist
  );
  camera.lookAt(cameraTarget);
}
updateCamera();

// Shared uniforms (referenced by several materials)
const shared = {
  uTime: { value: 0 },
  uFogColor: { value: fogColor.clone() },
  uFogDensity: { value: PARAMS.post.fogDensity },
  uPointScale: { value: 1 },
  uLiquid: { value: new Color(PARAMS.colors.liquid) },
  uGlow: { value: new Color(PARAMS.colors.glow) },
  uAvgLight: { value: 1 }
};

// ============================================================================
// Utilities
// ============================================================================
function mulberry32(a: number): () => number {
  return function () {
    a |= 0; a = (a + 0x6D2B79F5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const GLSL_NOISE = /* glsl */`
  float hash13(vec3 p) {
    p = fract(p * 0.1031);
    p += dot(p, p.zyx + 31.32);
    return fract((p.x + p.y) * p.z);
  }
  float vnoise(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(
      mix(mix(hash13(i), hash13(i + vec3(1,0,0)), f.x), mix(hash13(i + vec3(0,1,0)), hash13(i + vec3(1,1,0)), f.x), f.y),
      mix(mix(hash13(i + vec3(0,0,1)), hash13(i + vec3(1,0,1)), f.x), mix(hash13(i + vec3(0,1,1)), hash13(i + vec3(1,1,1)), f.x), f.y),
      f.z);
  }
`;

// ============================================================================
// Procedural textures (sci-fi hull panels, floor grating)
// ============================================================================
function createCanvas(size: number): HTMLCanvasElement {
  const c = document.createElement('canvas');
  c.width = c.height = size;
  return c;
}

function createPanelTextures(size: number, seed: number) {
  const rng = mulberry32(seed);
  const colC = createCanvas(size), hC = createCanvas(size), rC = createCanvas(size);
  const cc = colC.getContext('2d')!, hc = hC.getContext('2d')!, rc = rC.getContext('2d')!;
  const gray = (v: number): string => `rgb(${v | 0},${v | 0},${v | 0})`;

  cc.fillStyle = '#8c9696'; cc.fillRect(0, 0, size, size);
  hc.fillStyle = gray(110); hc.fillRect(0, 0, size, size);
  rc.fillStyle = gray(170); rc.fillRect(0, 0, size, size);

  // Subdivide into hull panels
  const rects: [number, number, number, number][] = [];
  const split = (x: number, y: number, w: number, h: number, d: number): void => {
    if (d > 4 || (d > 1 && rng() < 0.28) || w < 70 || h < 70) { rects.push([x, y, w, h]); return; }
    const vertical = w > h ? rng() < 0.8 : rng() < 0.2;
    if (vertical) {
      const s = Math.round(w * (0.3 + rng() * 0.4));
      split(x, y, s, h, d + 1); split(x + s, y, w - s, h, d + 1);
    } else {
      const s = Math.round(h * (0.3 + rng() * 0.4));
      split(x, y, w, s, d + 1); split(x, y + s, w, h - s, d + 1);
    }
  };
  split(0, 0, size, size, 0);

  for (const [x, y, w, h] of rects) {
    const tone = rng();
    // Raised panel face
    hc.fillStyle = gray(135 + tone * 40); hc.fillRect(x + 5, y + 5, w - 10, h - 10);
    cc.fillStyle = tone > 0.5 ? `rgba(255,255,255,${(tone - 0.5) * 0.14})` : `rgba(0,10,10,${(0.5 - tone) * 0.35})`;
    cc.fillRect(x + 3, y + 3, w - 6, h - 6);
    rc.fillStyle = gray(120 + tone * 90); rc.fillRect(x + 3, y + 3, w - 6, h - 6);

    // Seams
    hc.strokeStyle = gray(30); hc.lineWidth = 5; hc.strokeRect(x + 2.5, y + 2.5, w - 5, h - 5);
    cc.strokeStyle = 'rgba(0,0,0,0.75)'; cc.lineWidth = 3; cc.strokeRect(x + 1.5, y + 1.5, w - 3, h - 3);
    cc.strokeStyle = 'rgba(255,255,255,0.10)'; cc.lineWidth = 1; cc.strokeRect(x + 5.5, y + 5.5, w - 11, h - 11);

    const f = rng();
    const ix = x + 16, iy = y + 16, iw = w - 32, ih = h - 32;
    if (iw < 20 || ih < 20) continue;
    if (f < 0.22) {
      // Vent slats
      const n = 4 + (rng() * 10) | 0;
      const horizontal = iw > ih;
      for (let i = 0; i < n; i++) {
        if (horizontal) {
          const sy = iy + (i + 0.5) * ih / n;
          hc.fillStyle = gray(20); hc.fillRect(ix, sy - 2, iw, 4);
          cc.fillStyle = 'rgba(0,0,0,0.7)'; cc.fillRect(ix, sy - 2, iw, 4);
        } else {
          const sx = ix + (i + 0.5) * iw / n;
          hc.fillStyle = gray(20); hc.fillRect(sx - 2, iy, 4, ih);
          cc.fillStyle = 'rgba(0,0,0,0.7)'; cc.fillRect(sx - 2, iy, 4, ih);
        }
      }
    } else if (f < 0.45) {
      // Recessed inset with bevel
      hc.fillStyle = gray(95); hc.fillRect(ix, iy, iw, ih);
      hc.strokeStyle = gray(60); hc.lineWidth = 3; hc.strokeRect(ix, iy, iw, ih);
      cc.strokeStyle = 'rgba(0,0,0,0.55)'; cc.lineWidth = 2; cc.strokeRect(ix, iy, iw, ih);
      rc.fillStyle = gray(90 + rng() * 60); rc.fillRect(ix, iy, iw, ih);
    } else if (f < 0.6) {
      // Horizontal ribs
      const n = 2 + (rng() * 3) | 0;
      for (let i = 0; i < n; i++) {
        const sy = iy + (i + 0.5) * ih / n;
        hc.fillStyle = gray(200); hc.fillRect(ix, sy - 5, iw, 10);
        cc.fillStyle = 'rgba(255,255,255,0.07)'; cc.fillRect(ix, sy - 5, iw, 3);
        cc.fillStyle = 'rgba(0,0,0,0.4)'; cc.fillRect(ix, sy + 4, iw, 2);
      }
    } else if (f < 0.7) {
      // Small label plate
      const lw = Math.min(iw, 60 + rng() * 60), lh = 10 + rng() * 10;
      cc.fillStyle = 'rgba(200,215,210,0.22)'; cc.fillRect(ix, iy, lw, lh);
      for (let k = 0; k < 6; k++) { cc.fillStyle = 'rgba(0,0,0,0.5)'; cc.fillRect(ix + 4 + k * lw / 7, iy + lh * 0.35, lw / 10, lh * 0.3); }
    }
    // Rivets
    if (rng() < 0.6) {
      const pts: [number, number][] = [[x + 10, y + 10], [x + w - 10, y + 10], [x + 10, y + h - 10], [x + w - 10, y + h - 10]];
      for (const [px, py] of pts) {
        hc.fillStyle = gray(230); hc.beginPath(); hc.arc(px, py, 3, 0, Math.PI * 2); hc.fill();
        cc.fillStyle = 'rgba(255,255,255,0.18)'; cc.beginPath(); cc.arc(px, py, 2.5, 0, Math.PI * 2); cc.fill();
      }
    }
    // Grime streaks
    if (rng() < 0.5) {
      const g = cc.createLinearGradient(0, y, 0, y + h);
      g.addColorStop(0, 'rgba(0,8,8,0.35)'); g.addColorStop(1, 'rgba(0,8,8,0)');
      cc.fillStyle = g;
      for (let s = 0; s < 6; s++) cc.fillRect(x + rng() * w, y, 2 + rng() * 6, h * (0.3 + rng() * 0.7));
    }
  }

  // Fine grime noise
  for (let i = 0; i < 14000; i++) {
    const px = rng() * size, py = rng() * size, r = 0.5 + rng() * 2.2;
    const dark = rng() < 0.7;
    cc.fillStyle = dark ? `rgba(0,0,0,${rng() * 0.12})` : `rgba(255,255,255,${rng() * 0.05})`;
    cc.fillRect(px, py, r, r);
    rc.fillStyle = dark ? `rgba(255,255,255,${rng() * 0.1})` : `rgba(0,0,0,${rng() * 0.15})`;
    rc.fillRect(px, py, r * 2, r * 2);
  }

  const maxAniso = renderer.capabilities.getMaxAnisotropy();
  const make = (canvas: HTMLCanvasElement, srgb: boolean): CanvasTexture => {
    const t = new CanvasTexture(canvas);
    t.wrapS = t.wrapT = RepeatWrapping;
    t.anisotropy = Math.min(16, maxAniso);
    if (srgb) t.colorSpace = SRGBColorSpace;
    return t;
  };
  return { map: make(colC, true), bump: make(hC, false), rough: make(rC, false) };
}

function createGratingTextures(size: number) {
  const colC = createCanvas(size), hC = createCanvas(size);
  const cc = colC.getContext('2d')!, hc = hC.getContext('2d')!;
  cc.fillStyle = '#050707'; cc.fillRect(0, 0, size, size);
  hc.fillStyle = '#000'; hc.fillRect(0, 0, size, size);
  // One tile = full walkway width x 1.8 m: 8 x 8 cells (~34 x 22 cm)
  const rows = 8, cols = 8;
  const rowBar = size * 0.03, colBar = size * 0.024;
  for (let r = 0; r <= rows; r++) {
    const y = r * size / rows;
    cc.fillStyle = '#7d8a8a'; cc.fillRect(0, y - rowBar / 2, size, rowBar);
    cc.fillStyle = '#b8c4c4'; cc.fillRect(0, y - rowBar / 2, size, rowBar * 0.22);
    cc.fillStyle = 'rgba(0,0,0,0.55)'; cc.fillRect(0, y + rowBar / 2, size, rowBar * 0.35);
    hc.fillStyle = '#fff'; hc.fillRect(0, y - rowBar / 2, size, rowBar);
  }
  for (let c = 0; c <= cols; c++) {
    const x = c * size / cols;
    cc.fillStyle = '#6f7c7c'; cc.fillRect(x - colBar / 2, 0, colBar, size);
    cc.fillStyle = '#a9b6b6'; cc.fillRect(x - colBar / 2, 0, colBar * 0.22, size);
    hc.fillStyle = '#e8e8e8'; hc.fillRect(x - colBar / 2, 0, colBar, size);
  }
  // Bolted cross points
  for (let r = 0; r <= rows; r++) for (let c = 0; c <= cols; c++) {
    cc.fillStyle = '#95a2a2'; cc.fillRect(c * size / cols - colBar * 0.7, r * size / rows - rowBar * 0.7, colBar * 1.4, rowBar * 1.4);
  }
  const maxAniso = renderer.capabilities.getMaxAnisotropy();
  const make = (canvas: HTMLCanvasElement, srgb: boolean): CanvasTexture => {
    const t = new CanvasTexture(canvas);
    t.wrapS = t.wrapT = RepeatWrapping;
    t.anisotropy = Math.min(16, maxAniso);
    if (srgb) t.colorSpace = SRGBColorSpace;
    return t;
  };
  return { map: make(colC, true), bump: make(hC, false) };
}

