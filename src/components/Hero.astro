// ============================================================================
// Corridor shell
// ============================================================================
const tmpMatrix = new Matrix4();
const tmpQuat = new Quaternion();
const tmpEuler = new Euler();
const tmpPos = new Vector3();
const tmpScale = new Vector3();
const tmpColor = new Color();
const tmpVecA = new Vector3();
const tmpVecB = new Vector3();
const tmpVecC = new Vector3();

function octagonSide(i: number) {
  const a = OCTAGON[i], b = OCTAGON[(i + 1) % 8];
  const ex = b[0] - a[0], ey = b[1] - a[1];
  const len = Math.hypot(ex, ey);
  return { a, b, len, dir: [ex / len, ey / len] as [number, number], normal: [-ey / len, ex / len] as [number, number] };
}

function buildShell() {
  const pos: number[] = [], nrm: number[] = [], uv: number[] = [], idx: number[] = [];
  let perimeter = 0;
  const texScale = 1 / 3.2;
  for (let i = 1; i < 8; i++) {
    const s = octagonSide(i);
    const base = pos.length / 3;
    const v0 = perimeter * texScale, v1 = (perimeter + s.len) * texScale;
    const u0 = -CORRIDOR_FRONT * texScale, u1 = -CORRIDOR_BACK * texScale;
    pos.push(s.a[0], s.a[1], CORRIDOR_FRONT, s.b[0], s.b[1], CORRIDOR_FRONT, s.b[0], s.b[1], CORRIDOR_BACK, s.a[0], s.a[1], CORRIDOR_BACK);
    for (let k = 0; k < 4; k++) nrm.push(s.normal[0], s.normal[1], 0);
    uv.push(u0, v0, u0, v1, u1, v1, u1, v0);
    idx.push(base, base + 1, base + 2, base, base + 2, base + 3);
    perimeter += s.len;
  }
  const g = new BufferGeometry();
  g.setAttribute('position', new Float32BufferAttribute(pos, 3));
  g.setAttribute('normal', new Float32BufferAttribute(nrm, 3));
  g.setAttribute('uv', new Float32BufferAttribute(uv, 2));
  g.setIndex(idx);
  return new Mesh(g, wallMaterial);
}
scene.add(buildShell());

// Floor: side panels + central grating walkway
function buildFloor() {
  const group = new Group();
  const len = CORRIDOR_FRONT - CORRIDOR_BACK;
  const midZ = (CORRIDOR_FRONT + CORRIDOR_BACK) / 2;
  const sideW = 6.2 - 1.35;
  for (const sign of [-1, 1]) {
    const g = new PlaneGeometry(sideW, len);
    const uvAttr = g.attributes.uv;
    for (let i = 0; i < uvAttr.count; i++) uvAttr.setXY(i, uvAttr.getX(i) * sideW / 2.6, uvAttr.getY(i) * len / 2.6);
    g.rotateX(-Math.PI / 2);
    const m = new Mesh(g, floorMaterial);
    m.position.set(sign * (1.35 + sideW / 2), 0, midZ);
    group.add(m);
  }
  const gg = new PlaneGeometry(2.7, len);
  const guv = gg.attributes.uv;
  for (let i = 0; i < guv.count; i++) guv.setXY(i, guv.getX(i) * 1.0, guv.getY(i) * len / 1.8);
  gg.rotateX(-Math.PI / 2);
  const grating = new Mesh(gg, gratingMaterial);
  grating.position.set(0, 0.012, midZ);
  group.add(grating);
  return group;
}
