  add('#7ff0ff', 2.0, [5, 0.5, -8], [0.2, 4, 1.4]);
  add('#bff8ff', 5.0, [0, 1, -10], [1.5, 3, 0.2]);
  add('#9ff3ff', 2.0, [0, 5, 0], [2, 0.1, 12]);
  add('#ff8a2a', 4.0, [-4.5, -3, 3], [1.2, 0.1, 0.1]);
