const backWallExtraMaterials: MeshStandardMaterial[] = [];
function buildBulkheadWall() {
  // Built facing +z at local z = 0; placed and rotated for each corridor end
  const group = new Group();
  const shape = new Shape();
  OCTAGON.forEach(([x, y], i) => (i === 0 ? shape.moveTo(x, y) : shape.lineTo(x, y)));
  const doorR = 3.7, doorY = 4.1;
  const hole = new Path();
  hole.absarc(0, doorY, doorR, 0, Math.PI * 2, true);
  shape.holes.push(hole);
  const wallGeo = new ShapeGeometry(shape, 48);
  const uvA = wallGeo.attributes.uv;
  for (let i = 0; i < uvA.count; i++) uvA.setXY(i, uvA.getX(i) / 3.2, uvA.getY(i) / 3.2);
  group.add(new Mesh(wallGeo, wallMaterial));

  const tunnelGeo = new CylinderGeometry(doorR, doorR, 2.4, 48, 1, true);
  tunnelGeo.rotateX(Math.PI / 2);
  const tunnelMat = new MeshStandardMaterial({ color: metalColor.clone().multiplyScalar(0.5), roughness: 0.5, metalness: 0.85, side: BackSide });
  backWallExtraMaterials.push(tunnelMat);
  const tunnel = new Mesh(tunnelGeo, tunnelMat);
  tunnel.position.set(0, doorY, -1.2);
  group.add(tunnel);

  const discGeo = new CircleGeometry(doorR, 48);
  const uvD = discGeo.attributes.uv;
  for (let i = 0; i < uvD.count; i++) uvD.setXY(i, uvD.getX(i) * 2.2, uvD.getY(i) * 2.2);
  const disc = new Mesh(discGeo, hardwareMaterial);
  disc.position.set(0, doorY, -2.4);
  group.add(disc);

  // Concentric rings
  const ring1 = new Mesh(new TorusGeometry(doorR, 0.26, 12, 72), hardwareMaterial);
  ring1.position.set(0, doorY, 0.05);
  const ring2 = new Mesh(new TorusGeometry(doorR - 0.55, 0.12, 10, 72), darkMetalMaterial);
  ring2.position.set(0, doorY, -2.3);
  const ring3 = new Mesh(new TorusGeometry(1.2, 0.18, 10, 48), hardwareMaterial);
  ring3.position.set(0, doorY, -2.3);
  group.add(ring1, ring2, ring3);

  // Amber arcs on the bulkhead frame
  const arcGeo = new TorusGeometry(doorR - 0.02, 0.035, 6, 32, 0.85);
  for (const rot of [Math.PI - 0.42, -0.42]) {
    const arc = new Mesh(arcGeo, amberEmissive);
    arc.position.set(0, doorY, 0.32);
    arc.rotation.z = rot;
    group.add(arc);
  }
  // Radial door segments
  const segments = new InstancedMesh(new BoxGeometry(1, 1, 1), hardwareMaterial, 12);
  for (let i = 0; i < 12; i++) {
    const a = (i / 12) * Math.PI * 2;
    tmpPos.set(-Math.cos(a + Math.PI / 2) * 2.4, doorY + Math.sin(a + Math.PI / 2) * 2.4, -2.32);
    tmpQuat.setFromEuler(tmpEuler.set(0, 0, a));
    tmpScale.set(0.14, 2.0, 0.1);
    tmpMatrix.compose(tmpPos, tmpQuat, tmpScale);
    segments.setMatrixAt(i, tmpMatrix);
    segments.setColorAt(i, tmpColor.setScalar(0.6));
  }
  group.add(segments);
  return group;
}
const backBulkhead = buildBulkheadWall();
backBulkhead.position.z = CORRIDOR_BACK;
const frontBulkhead = backBulkhead.clone();
