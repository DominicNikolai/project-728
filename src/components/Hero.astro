// Octagonal structural ribs
function buildRibs(): void {
  const outer = new Shape();
  const outerPts: [number, number][] = [[-6.2, -0.3], [6.2, -0.3], [7.62, 1.4], [7.62, 6.6], [6.0, 8.62], [-6.0, 8.62], [-7.62, 6.6], [-7.62, 1.4]];
  outerPts.forEach(([x, y], i) => (i === 0 ? outer.moveTo(x, y) : outer.lineTo(x, y)));
  const innerPts: [number, number][] = [[-5.55, -0.2], [5.55, -0.2], [6.95, 1.65], [6.95, 6.35], [5.55, 7.95], [-5.55, 7.95], [-6.95, 6.35], [-6.95, 1.65]];
  const hole = new Path();
  [...innerPts].reverse().forEach(([x, y], i) => (i === 0 ? hole.moveTo(x, y) : hole.lineTo(x, y)));
  outer.holes.push(hole);
  const ribGeo = new ExtrudeGeometry(outer, { depth: 0.7, bevelEnabled: true, bevelThickness: 0.05, bevelSize: 0.05, bevelSegments: 1, curveSegments: 1 });
  ribGeo.translate(0, 0, -0.35);
  const uvA = ribGeo.attributes.uv;
  for (let i = 0; i < uvA.count; i++) uvA.setXY(i, uvA.getX(i) * 0.3, uvA.getY(i) * 0.3);

  // Inner trim ring (layered frame detail)
  const trim = new Shape();
  innerPts.forEach(([x, y], i) => {
    const sx = x * 1.005, sy = y < 0 ? -0.2 : y;
    i === 0 ? trim.moveTo(sx, sy) : trim.lineTo(sx, sy);
  });
  const trimInner: [number, number][] = [[-5.3, -0.15], [5.3, -0.15], [6.72, 1.75], [6.72, 6.25], [5.4, 7.72], [-5.4, 7.72], [-6.72, 6.25], [-6.72, 1.75]];
  const trimHole = new Path();
  [...trimInner].reverse().forEach(([x, y], i) => (i === 0 ? trimHole.moveTo(x, y) : trimHole.lineTo(x, y)));
  trim.holes.push(trimHole);
  const trimGeo = new ExtrudeGeometry(trim, { depth: 0.22, bevelEnabled: true, bevelThickness: 0.03, bevelSize: 0.03, bevelSegments: 1, curveSegments: 1 });
  trimGeo.translate(0, 0, -0.11);
  const uvB = trimGeo.attributes.uv;
  for (let i = 0; i < uvB.count; i++) uvB.setXY(i, uvB.getX(i) * 0.3, uvB.getY(i) * 0.3);

  const ribs = new InstancedMesh(ribGeo, hardwareMaterial, RIB_Z.length);
  const trims = new InstancedMesh(trimGeo, darkMetalMaterial, RIB_Z.length * 2);
  RIB_Z.forEach((z, i) => {
    tmpMatrix.makeTranslation(0, 0, z); ribs.setMatrixAt(i, tmpMatrix);
    tmpMatrix.makeTranslation(0, 0, z + 0.48); trims.setMatrixAt(i * 2, tmpMatrix);
    tmpMatrix.makeTranslation(0, 0, z - 0.48); trims.setMatrixAt(i * 2 + 1, tmpMatrix);
  });
  scene.add(ribs, trims);
}
buildRibs();

// ============================================================================
// Greeble details: instanced boxes and cylinders
// ============================================================================
const boxDetails: Greeble[] = [];
const cylDetails: Greeble[] = [];
const amberDetails: Greeble[] = [];
const rngDetail = mulberry32(99);

function sideMatrix(sideIndex: number, s: number, z: number, w: number, t: number, l: number, lift = 0): Greeble {
  const side = octagonSide(sideIndex);
  const cx = side.a[0] + side.dir[0] * s + side.normal[0] * (t / 2 + lift);
  const cy = side.a[1] + side.dir[1] * s + side.normal[1] * (t / 2 + lift);
  tmpVecA.set(side.dir[0], side.dir[1], 0);
  tmpVecB.set(side.normal[0], side.normal[1], 0);
  tmpVecC.set(0, 0, 1);
  const m = new Matrix4().makeBasis(tmpVecA, tmpVecB, tmpVecC);
  const q = new Quaternion().setFromRotationMatrix(m);
  return { p: new Vector3(cx, cy, z), q, s: new Vector3(w, t, l) };
}

function addWallGreebles(): void {
  for (let side = 1; side < 8; side++) {
    const info = octagonSide(side);
    for (let z = CORRIDOR_FRONT; z > CORRIDOR_BACK;) {
      const l = 0.5 + rngDetail() * 2.2;
      const nPanels = 1 + (rngDetail() * 3) | 0;
      for (let k = 0; k < nPanels; k++) {
        const w = info.len * (0.12 + rngDetail() * 0.4);
        const s = w / 2 + rngDetail() * (info.len - w);
        const t = 0.04 + rngDetail() * 0.16;
        const d = sideMatrix(side, s, z - l / 2, w, t, l * (0.8 + rngDetail() * 0.2));
        d.tone = 0.6 + rngDetail() * 0.6;
        boxDetails.push(d);
      }
      z -= l + rngDetail() * 0.4;
    }
    // Long pipes along the corridor
    const pipeCount = side === 4 ? 4 : 2;
    for (let k = 0; k < pipeCount; k++) {
      const r = 0.06 + rngDetail() * 0.12;
      const s = info.len * (0.15 + 0.7 * (k + rngDetail() * 0.5) / pipeCount);
      const d = sideMatrix(side, s, (CORRIDOR_FRONT + CORRIDOR_BACK) / 2, 1, 1, 1, r + 0.12);
      d.q = new Quaternion().setFromEuler(tmpEuler.set(Math.PI / 2, 0, 0));
      d.s = new Vector3(r, CORRIDOR_FRONT - CORRIDOR_BACK, r);
      d.tone = 0.5 + rngDetail() * 0.4;
      cylDetails.push(d);
      // Pipe clamps
      for (let z = CORRIDOR_FRONT - 1; z > CORRIDOR_BACK; z -= 2.2) {
        const c = sideMatrix(side, s, z, r * 2 + 0.12, r * 2 + 0.16, 0.12, 0.02);
        c.tone = 0.7;
        boxDetails.push(c);
      }
    }
  }
}
addWallGreebles();

function addCeilingMachinery(): void {
  const q0 = new Quaternion();
  const qZ = new Quaternion().setFromEuler(new Euler(Math.PI / 2, 0, 0));
  const qX = new Quaternion().setFromEuler(new Euler(0, 0, Math.PI / 2));
  // Central spine blocks
  for (let z = CORRIDOR_FRONT - 1; z > -21; z -= 2.6 + rngDetail() * 1.2) {
    const w = 1.6 + rngDetail() * 1.4, h = 0.6 + rngDetail() * 0.9, l = 1.2 + rngDetail() * 1.4;
    boxDetails.push({ p: new Vector3((rngDetail() - 0.5) * 0.6, 8.6 - h / 2, z), q: q0, s: new Vector3(w, h, l), tone: 0.7 + rngDetail() * 0.4 });
    boxDetails.push({ p: new Vector3(0, 8.6 - h - 0.12, z), q: q0, s: new Vector3(w * 0.7, 0.24, l * 0.8), tone: 0.5 });
    if (rngDetail() < 0.7) {
      const r = 0.25 + rngDetail() * 0.25;
      cylDetails.push({ p: new Vector3(0, 8.6 - h - 0.3 - r, z - l * 0.2), q: qX, s: new Vector3(r, w * 1.1, r), tone: 0.6 });
    }
    // Side canisters
    for (const sx of [-1, 1]) {
      if (rngDetail() < 0.6) {
        const r = 0.3 + rngDetail() * 0.25;
        cylDetails.push({ p: new Vector3(sx * (2.2 + rngDetail()), 8.6 - r - 0.05, z), q: qZ, s: new Vector3(r, 1 + rngDetail() * 1.5, r), tone: 0.75 });
      }
    }
  }
  // Hub above the central tank
  const hz = TANKS[6].z;
  const hub: [number, number, number][] = [[1.9, 0.5, 8.3], [1.5, 0.35, 7.9], [1.75, 0.12, 7.66], [1.2, 0.3, 7.48], [0.9, 0.5, 7.12]];
  hub.forEach(([r, h, y]) => cylDetails.push({ p: new Vector3(0, y, hz), q: q0, s: new Vector3(r, h, r), tone: 0.8 }));
  // Walkway rails
  for (const sx of [-1.38, 1.38]) {
    boxDetails.push({ p: new Vector3(sx, 0.05, (CORRIDOR_FRONT + CORRIDOR_BACK) / 2), q: q0, s: new Vector3(0.12, 0.1, CORRIDOR_FRONT - CORRIDOR_BACK), tone: 0.9 });
  }
  // Floor-level amber markers and wall base lights
  for (let z = CORRIDOR_FRONT - 1.5; z > CORRIDOR_BACK + 1; z -= 3.0) {
    for (const sx of [-1.75, 1.75]) amberDetails.push({ p: new Vector3(sx, 0.02, z), q: q0, s: new Vector3(0.06, 0.03, 0.55) });
  }
  RIB_Z.forEach((z) => {
    for (const sideIdx of [1, 7]) {
      const d = sideMatrix(sideIdx, sideIdx === 1 ? 0.55 : octagonSide(7).len - 0.55, z + 0.45, 0.6, 0.05, 0.05, 0.08);
      amberDetails.push(d);
      const d2 = sideMatrix(sideIdx, sideIdx === 1 ? 0.8 : octagonSide(7).len - 0.8, z + 0.45, 0.35, 0.05, 0.05, 0.08);
      amberDetails.push(d2);
    }
  });
}
addCeilingMachinery();

